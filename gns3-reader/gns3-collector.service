[Unit]
Description=Reads templates from all configured GNS3 servers
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=junioradmin
Group=junioradmin
WorkingDirectory=/home/junioradmin/gns3-reader
EnvironmentFile=-/home/junioradmin/gns3-reader/.env

# A request file (see gns3-collector.path) is consumed before the run, so a request during a run starts another one
ExecStartPre=-/bin/rm -f /home/junioradmin/gns3-reader/trigger/refresh
ExecStart=/home/junioradmin/gns3-reader/venv/bin/python /home/junioradmin/gns3-reader/read_gns3_templates.py --config /home/junioradmin/gns3-reader/gns3_config.yml

NoNewPrivileges=true
ProtectSystem=false
